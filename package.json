{
  "name": "monid-enrich",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "check:production-config": "node scripts/assert-production-env.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts && npm run test:server",
    "test:server": "node --import tsx --import ./tests/support/server-only-test-hook.mjs --test tests/server/*.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "smoke:realtime": "tsx scripts/smoke-neon-realtime.ts",
    "test:self-hosted": "playwright test --config playwright.self-hosted.config.ts",
    "test:browser:smoke": "playwright test --config playwright.self-hosted.config.ts mcp-access.spec.ts provider-keys.spec.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.105",
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.10.8",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@databuddy/sdk": "3.5.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.15",
    "@ironcalc/wasm": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neon/realtime": "^0.2.1",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-virtual": "^3.14.24",
    "@typesafe-ai/sdk": "^0.7.0",
    "@uiw/react-md-editor": "^4.2.3",
    "ai": "^7.0.157",
    "clsx": "^2.1.1",
    "context.dev": "^3.19.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.64.0",
    "marked": "^18.1.3",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "pdfmake": "^0.3.14",
    "react": "19.3.0",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.2.0",
    "undici": "^7.30.2",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.39",
    "@neon/config": "^1.14.6",
    "@next/env": "16.4.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.7",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "Standalone spreadsheet for company and people research, enrichment, and review, powered by Monid.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "homepage": "https://github.com/GameMachina/monid-enrich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GameMachina/monid-enrich.git"
  },
  "bugs": {
    "url": "https://github.com/GameMachina/monid-enrich/issues"
  }
}
