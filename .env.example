# Postgres is required for managed SaaS and multi-instance deployments. Local
# single-process development can omit it and use embedded PGlite under .data/.
# The product is Monid Enrich; ENRICHABLE_* variable names are retained as
# internal compatibility identifiers and must be used exactly as listed.
DATABASE_URL=
# Neon CLI also supplies the direct URL for schema migrations. If set, the
# migration script prefers it over the pooled application URL above.
DATABASE_URL_UNPOOLED=

# Managed SaaS identity. Choose `clerk` for hosted customer accounts or
# `self-hosted` for a private single-operator deployment. Production fails
# closed when this is unset. Configure Clerk Organizations for team workspaces.
ENRICHABLE_AUTH_MODE=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Hosted SaaS billing. Configure an active $37 USD one-time Stripe Price and a
# reusable Payment Link that redirects to /access-required?billing=success&session_id={CHECKOUT_SESSION_ID}.
# Register /api/stripe/webhook for Checkout, refund, and dispute events. App access is
# granted after payment confirmation; Monid and optional OpenAI usage are billed separately.
# ENRICHABLE_BILLING_REQUIRED=false
# Verified email addresses that may access the full product without the $37 purchase.
# Keep this list limited to the owner and intentional beta testers.
# ENRICHABLE_BILLING_EXEMPT_EMAILS=jalendnelson@gmail.com
# ENRICHABLE_PLATFORM_ADMIN_EMAILS=additional-verified-operator@example.com
# Server-side Checkout Sessions bind each $37 one-time payment to the selected organization.
# STRIPE_SECRET_KEY=rk_… # restricted key with Checkout Session write permission recommended
# STRIPE_WEBHOOK_SECRET=
# STRIPE_ONE_TIME_PRICE_ID=
# Optional: retain the old Payment Link ID while processing historical payments.
# STRIPE_PAYMENT_LINK_ID=
# ENRICHABLE_APP_URL=https://your-app.example

# Durable hosted enrichment queue. Required for long runs to survive tab closure
# and Vercel request lifetimes. The worker route is protected by this secret.
# ENRICHABLE_DURABLE_ENRICHMENT=false
# CRON_SECRET=

# Shared Postgres credential vault and recoverable MCP/AgentWeb keys. Required
# in managed mode; identical on every server using the same database.
# ENRICHABLE_MCP_ENCRYPTION_SECRET=
# Set the old root here during the staged key-rotation procedure. Keep it until
# POST /api/internal/credentials/rotate reports zero remaining credentials.
# ENRICHABLE_MCP_ENCRYPTION_PREVIOUS_SECRET=

# Optional location for the embedded workspace database. Defaults to .data/database.
ENRICHABLE_LOCAL_DATABASE_PATH=

# Optional stable local-vault secret (32+ chars) for self-hosted deployments.
# Persistent self-hosted mode stores a generated key under .data/ if omitted.
ENRICHABLE_LOCAL_VAULT_SECRET=

# Optional directory for the self-hosted encrypted credential vault. Defaults to .data/.
ENRICHABLE_LOCAL_VAULT_DIR=

# Optional shared workspace realtime. `neon deploy` provisions it from neon.ts
# and `neon env pull --service postgres --service realtime` supplies these. If
# absent, clients poll for changes. Keep the shared secret server-side.
# NEON_REALTIME_URL=wss://your-branch.rt.region.aws.neon.tech/
# NEON_REALTIME_SECRET=
# ENRICHABLE_REALTIME_ENABLED=true

# Optional operator-provided keys are disabled by default. Prefer workspace
# members adding their own Monid/OpenAI keys in Configuration. Never expose
# these values to the browser.
# MONID_API_KEY=
# OPENAI_API_KEY=
# ENRICHABLE_PASSWORD=
# ENRICHABLE_ALLOW_SERVER_KEYS_WITHOUT_PASSWORD=false

# Default OpenAI model used only with a workspace member's supplied key.
# OPENAI_MODEL=gpt-5.4-mini

# Optional public origin / product analytics.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_DATABUDDY_CLIENT_ID=
